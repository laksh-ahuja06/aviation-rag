# Copy to .env and fill in. Never commit .env.
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is overloaded or out of daily quota
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite
# Cross-encoder logit below which a record is not evidence (calibrated: see DEV_LOG.md)
EVIDENCE_THRESHOLD=0.0
